# ResolveIQ — example environment file
#
# Copy to `.env` and fill in real values. `.env` is gitignored; never commit real secrets.
#
#   cp .env.example .env
#
# SECURITY NOTE (NEP-09): every variable in this file is read by the BACKEND only.
# The frontend container receives none of them. In particular, Vite inlines any
# `VITE_*` variable into the JavaScript bundle at build time, so an LLM provider
# key must NEVER be given a `VITE_` prefix.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_ENV=development            # development | test | production
APP_LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# Comma-separated list of allowed CORS origins.
# The frontend dev server origin is listed explicitly; do not use "*" with credentials.
CORS_ORIGINS=http://localhost:5173

# Comma-separated list of hostnames this service answers to (Host header allow-list).
# "*" allows any host and is convenient in development; production refuses "*" at
# startup and requires the real hostname(s).
ALLOWED_HOSTS=*

# Whether Swagger/ReDoc and /openapi.json are served.
# Leave EMPTY (or "auto") for the environment-dependent default: on in development and
# test, OFF in production. Set true to force them on, false to force them off.
EXPOSE_DOCS=

# Baseline security response headers (nosniff, frame-deny, referrer-policy).
SECURITY_HEADERS_ENABLED=true

# Fixed-window request rate limiting, keyed by client IP. Always ON in production;
# opt-in elsewhere so ordinary test runs are not throttled.
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60

# When running behind a reverse proxy (the nginx frontend container does this), uvicorn
# itself reads FORWARDED_ALLOW_IPS to decide which peers may set X-Forwarded-* used for
# the client IP. It is not read by app.settings, so it is intentionally commented out
# here; uncomment and set it in the process environment when deploying behind a proxy.
# FORWARDED_ALLOW_IPS=127.0.0.1

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------
POSTGRES_USER=resolveiq
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=resolveiq
POSTGRES_HOST=db
POSTGRES_PORT=5432

# SQLAlchemy URL used by the backend.
# Defaults target a local PostgreSQL on localhost (after running
# backend/scripts/create_dev_database.sql). `docker compose up` does NOT depend on
# these values: the container overrides DATABASE_URL with the service-name host "db"
# in its environment block, so a copy of this file works for both local and Docker.
DATABASE_URL=postgresql+psycopg://resolveiq:change-me-local-only@localhost:5432/resolveiq

# Disposable database for the migration integration tests.
# `alembic downgrade base` drops every table, so it must NEVER point at a database
# holding real data. Leave empty to derive it from DATABASE_URL by swapping only the
# database name; set it explicitly only to use a different server.
TEST_DATABASE_URL=postgresql+psycopg://resolveiq:change-me-local-only@localhost:5432/resolveiq_test

# ---------------------------------------------------------------------------
# Database (MySQL alternative)
# ---------------------------------------------------------------------------
# MySQL is also supported (ADR-014). To use it instead of PostgreSQL, replace
# DATABASE_URL and TEST_DATABASE_URL with these. Keep the same database name in
# both, so the disposable test database stays a sibling of the dev database.
#   mysql -h 127.0.0.1 -P 3306 -u root -p
#   CREATE DATABASE resolveiq CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci;
#   CREATE DATABASE resolveiq_test CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci;
#   CREATE USER 'resolveiq'@'%' IDENTIFIED BY '<password>';
#   GRANT ALL PRIVILEGES ON resolveiq.* TO 'resolveiq'@'%';
#   GRANT ALL PRIVILEGES ON resolveiq_test.* TO 'resolveiq'@'%';
#
# DATABASE_URL=mysql+pymysql://resolveiq:<password>@localhost:3306/resolveiq
# TEST_DATABASE_URL=mysql+pymysql://resolveiq:<password>@localhost:3306/resolveiq_test

# Creates the role and both databases on an existing PostgreSQL server, with no
# superuser rights. Run once as an administrator; see the header of the file.
#   psql -h 127.0.0.1 -p 5432 -U <superuser> -d postgres \
#     -v resolveiq_password='<password>' \
#     -f backend/scripts/create_dev_database.sql

# ---------------------------------------------------------------------------
# Production notes
# ---------------------------------------------------------------------------
# The values below are for local development. In production, override at minimum:
#   APP_ENV=production
#   DATABASE_URL          full connection URL, credentials from a secret store
#   TEST_DATABASE_URL     a DISPOSABLE database; the migration tests run
#                         `alembic downgrade base` against it, so never point it at
#                         data you care about
#   CORS_ORIGINS          the exact frontend origin(s), comma separated. Do not
#                         use "*" with credentials.
#   ALLOWED_HOSTS         the exact hostname(s) this service answers to. Do not use "*".
#   AUTH_MODE=token       and AUTH_SECRET (32+ random bytes from a secret store).
#                         APP_ENV=production refuses to start otherwise.
#   LLM_API_KEY           required once LLM_PROVIDER=openai
#   EXPOSE_DOCS           leave unset (docs off in production) unless you intend to
#                         publish the API schema
#
# The demo identity headers (X-Actor-Id / X-Actor-Role) are trivially spoofable and are
# refused in production: with APP_ENV=production the application requires AUTH_MODE=token
# and verifies a signed bearer token. See README §Security notes.
#
# Migrations are a separate deploy step, run before the new version serves traffic:
#   cd backend && alembic upgrade head
#
# Alembic reads DATABASE_URL from this file by default (through app.settings).
# Automation can point Alembic at a different target with ALEMBIC_DATABASE_URL,
# which the migration runner honours over everything else.

# LLM provider  (STK-06: injectable interface, deterministic mock by default)
# ---------------------------------------------------------------------------
# mock   = deterministic, offline, used by tests and by default in development.
# openai = any OpenAI-compatible chat-completions endpoint (hosted or self-hosted
#          gateway). Requires LLM_API_KEY; the process refuses to start without it
#          rather than silently answering from the mock.
LLM_PROVIDER=mock
LLM_MODEL=mock-deterministic-v1

# Base URL of the OpenAI-compatible API. Point this at a gateway or a local server
# for an on-prem deployment. Not used by the mock provider.
LLM_BASE_URL=https://api.openai.com/v1

LLM_API_KEY=                  # required when LLM_PROVIDER=openai; leave EMPTY for mock
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0

# Bumped whenever the prompt text changes; stored on every investigation so that
# model behaviour is attributable to a specific prompt version.
PROMPT_VERSION=prompt-v1

# ---------------------------------------------------------------------------
# Investigation behaviour
# ---------------------------------------------------------------------------
# How long an investigation's evidence fingerprint stays valid before the
# investigation is considered stale and approval is blocked. Also the age at
# which the recovery command treats a still-pending run as abandoned.
INVESTIGATION_TTL_HOURS=24

# How many times a transiently failing interpretation stage is retried within a
# single investigation before the run is completed with its last known result.
INVESTIGATION_MAX_ATTEMPTS=3

# Maximum length of a customer-supplied dispute description. Untrusted input.
DISPUTE_DESCRIPTION_MAX_CHARS=10000

# ---------------------------------------------------------------------------
# Dispute case storage
# ---------------------------------------------------------------------------
# postgres = durable (the default; the only value that survives restart).
# memory  = in-process store so the API and reviewer frontend can be exercised
#           with no database running. It is an EXPLICIT choice, reported by
#           GET /api/v1/capabilities, never a fallback: a service must not
#           silently degrade to an in-process store when the database is
#           unreachable.
CASE_STORE=postgres

# NOTE: monetary precision is a schema constant, not a setting. Every amount is
# NUMERIC(19,4) (NEP-01) so sub-cent unit prices (e.g. 0.0007 per API call)
# remain representable. There is no MONEY_SCALE environment variable to keep in
# sync with the mapping.

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# demo  = read the spoofable X-Actor-Id / X-Actor-Role headers (development only).
# token = verify an Authorization: Bearer <HS256 JWT> and take the role from the
#         signed claims. REQUIRED in production.
AUTH_MODE=demo

# Signing secret for AUTH_MODE=token. Never logged, never sent to the frontend.
# At least 16 characters are enforced; use 32+ random bytes from a secret store in
# production. Leave blank for the demo mode.
AUTH_SECRET=

# The `iss` claim a token must carry, and the token lifetime the operator CLI defaults
# to (seconds), plus the clock-skew allowance applied to `exp` (seconds).
AUTH_ISSUER=resolveiq
AUTH_TOKEN_TTL_SECONDS=3600
AUTH_LEEWAY_SECONDS=30

# Mint a token with the operator CLI (reads AUTH_SECRET from this file / the env):
#   cd backend && python -m scripts.issue_token --subject alice --role reviewer

# ---------------------------------------------------------------------------
# Demo-mode identity  (OQ-01 — THIS IS NOT REAL AUTHENTICATION)
# ---------------------------------------------------------------------------
# Only used when AUTH_MODE=demo. Analysts send X-Actor-Id / X-Actor-Role headers;
# they are trivially spoofable and exist so the review/approve flow can be
# demonstrated end to end. They are NOT a security control and are refused in
# production (APP_ENV=production requires AUTH_MODE=token).
DEMO_IDENTITY_ENABLED=true
DEMO_DEFAULT_ACTOR_ID=dev-analyst
DEMO_DEFAULT_ACTOR_ROLE=analyst
